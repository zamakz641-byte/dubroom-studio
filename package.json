{
  "name": "anime-manga-manhua-dubbing-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:desktop\"",
    "dev:desktop": "npm run dev -w apps/desktop",
    "start:desktop": "node scripts/start-desktop.cjs",
    "build": "npm run test:i18n && npm run build -w apps/desktop",
    "test:i18n": "node scripts/check-interface-text.cjs",
    "dev:api": "python -m uvicorn services.api.app.main:app --reload --host 127.0.0.1 --port 8766",
    "test:scroll": "npm run test:delivery",
    "test:export": "python scripts/test-export.py",
    "test:delivery": "node scripts/test-delivery-room.cjs",
    "test:library": "python scripts/test-library.py",
    "test:v2": "python scripts/test-v2.py",
    "test:model-download": "python scripts/test-model-download.py",
    "test:brands": "python scripts/test-brand-assets.py",
    "test:electron-assets": "node scripts/test-electron-assets.cjs",
    "test:titlebar": "node scripts/test-titlebar.cjs",
    "test:studio-edit": "node scripts/test-studio-editing.cjs",
    "test:activity": "python scripts/test-activity-simulation.py"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
